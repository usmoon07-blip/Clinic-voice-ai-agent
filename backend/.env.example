# ─────────────────────────────────────────────────────────────
#  KLINIKA AI VOICE AGENT — MUHIT O'ZGARUVCHILARI
#  Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
#  `.env` hech qachon git ga qo'shilmasin!
# ─────────────────────────────────────────────────────────────

# ── Umumiy ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
TZ=Asia/Tashkent
# ngrok bergan HTTPS manzil (webhook va Mini App uchun)
PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# ── Ma'lumotlar bazasi (Neon PostgreSQL) ────────────────────
# neon.tech → Connect → "Pooled connection" (manzilda "-pooler" bo'ladi)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Migratsiya uchun — xuddi shu manzil, lekin "-pooler" SIZ (Neon: "Direct connection").
# Neon pooler orqali jadval yaratib bo'lmaydi, shuning uchun bu alohida kerak.
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Admin panel ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Seed skripti shu login/parol bilan SUPERADMIN yaratadi
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=change-me-now
ADMIN_PANEL_ORIGIN=http://localhost:5174
MINIAPP_ORIGIN=http://localhost:5173

# ── Telegram ────────────────────────────────────────────────
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=123456789:AA...
# Mini App manzili (ngrok URL yoki local)
MINIAPP_URL=https://xxxx.ngrok-free.app
# Bot polling (true) yoki webhook (false)
TELEGRAM_USE_POLLING=true

# ── Telefoniya ──────────────────────────────────────────────
# twilio | sip
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
# Twilio webhook imzosini tekshirish (production da doim true)
TWILIO_VALIDATE_SIGNATURE=false
# Operator raqami (eskalatsiya uchun)
OPERATOR_PHONE_NUMBER=+998901234567

# SIP / Asterisk (TELEPHONY_PROVIDER=sip bo'lsa)
SIP_ARI_URL=http://127.0.0.1:8088
SIP_ARI_USER=asterisk
SIP_ARI_PASSWORD=asterisk
SIP_ARI_APP=clinic-voice
SIP_OPERATOR_EXTENSION=100

# ── SMS ─────────────────────────────────────────────────────
# twilio | eskiz | none
SMS_PROVIDER=twilio
# Eskiz.uz (O'zbekiston SMS provayderi) ishlatilsa:
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── STT / TTS ───────────────────────────────────────────────
# google | yandex | deepgram
STT_PROVIDER=google
STT_LANGUAGE=uz-UZ
STT_ALTERNATIVE_LANGUAGES=ru-RU
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
YANDEX_API_KEY=
DEEPGRAM_API_KEY=

# elevenlabs | google | yandex | twilio
TTS_PROVIDER=twilio
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Oldindan yozilgan salomlashuv audio fayli (3 soniya qoidasi uchun)
GREETING_AUDIO_URL_UZ=/audio/greeting-uz.mp3
GREETING_AUDIO_URL_RU=/audio/greeting-ru.mp3

# ── AI model ────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=400

# ── Biznes qoidalari (SiteSetting ga seed qilinadi) ─────────
CANCELLATION_WINDOW_MINUTES=120
MIN_LEAD_TIME_MINUTES=30
APPOINTMENT_BUFFER_MINUTES=5
NO_SHOW_THRESHOLD=3
RECORDING_RETENTION_DAYS=90
EMERGENCY_PHONE=103
CLINIC_NAME=Shifo klinikasi
CLINIC_PHONE=+998712000000
CLINIC_ADDRESS=Toshkent sh., Chilonzor t., Bunyodkor ko'chasi 1
CLINIC_LATITUDE=41.2995
CLINIC_LONGITUDE=69.2401

# ── Joblar ──────────────────────────────────────────────────
ENABLE_JOBS=true
JOB_INTERVAL_MS=120000
